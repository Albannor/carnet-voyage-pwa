{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:carnet-voyage:schema:voyage:1.3.0",
  "title": "Contrat voyage.json 1.3.0",
  "description": "Extension rétrocompatible ajoutant des illustrations locales et leur provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contentModelVersion", "id", "title", "destination", "language", "timeZone", "startDate", "endDate", "summary", "accommodations", "places", "days", "variants"],
  "properties": {
    "contentModelVersion": { "const": "1.3.0" },
    "id": { "$ref": "#/$defs/stableId" },
    "title": { "$ref": "#/$defs/title" },
    "destination": { "$ref": "#/$defs/destination" },
    "language": { "$ref": "#/$defs/languageTag" },
    "timeZone": { "$ref": "#/$defs/timeZone" },
    "startDate": { "$ref": "#/$defs/date" },
    "endDate": { "$ref": "#/$defs/date" },
    "summary": { "$ref": "#/$defs/description" },
    "accommodations": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/accommodation" } },
    "places": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/place" } },
    "days": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/day" } },
    "variants": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/variant" } },
    "documents": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/document" } },
    "reservations": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/reservation" } },
    "checklists": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/checklist" } },
    "illustrations": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/illustration" } },
    "coverIllustrationId": { "$ref": "#/$defs/stableId" }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 300 },
    "checklistDescription": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "date": { "type": "string", "format": "date" },
    "localTime": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "languageTag": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$" },
    "timeZone": { "type": "string", "maxLength": 64, "pattern": "^(?:UTC|[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)+)$" },
    "idReferences": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "illustrationReferences": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "destination": {
      "type": "object", "additionalProperties": false, "required": ["name", "countryCode"],
      "properties": { "name": { "$ref": "#/$defs/title" }, "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" } }
    },
    "externalLink": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "url"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "label": { "$ref": "#/$defs/title" }, "url": { "type": "string", "format": "uri", "maxLength": 2048 } }
    },
    "links": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/externalLink" } },
    "place": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "links"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "name": { "$ref": "#/$defs/title" }, "address": { "$ref": "#/$defs/shortText" }, "links": { "$ref": "#/$defs/links" } }
    },
    "accommodation": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "placeId", "startDate", "endDate"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "name": { "$ref": "#/$defs/title" }, "placeId": { "$ref": "#/$defs/stableId" }, "startDate": { "$ref": "#/$defs/date" }, "endDate": { "$ref": "#/$defs/date" } }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "links"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "title": { "$ref": "#/$defs/title" }, "description": { "$ref": "#/$defs/description" },
        "startTime": { "$ref": "#/$defs/localTime" }, "endTime": { "$ref": "#/$defs/localTime" }, "placeId": { "$ref": "#/$defs/stableId" },
        "accommodationId": { "$ref": "#/$defs/stableId" }, "links": { "$ref": "#/$defs/links" },
        "documentIds": { "$ref": "#/$defs/idReferences" }, "reservationIds": { "$ref": "#/$defs/idReferences" },
        "illustrationIds": { "$ref": "#/$defs/illustrationReferences" }
      }
    },
    "day": {
      "type": "object", "additionalProperties": false, "required": ["id", "date", "title", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "date": { "$ref": "#/$defs/date" }, "title": { "$ref": "#/$defs/title" }, "summary": { "$ref": "#/$defs/description" },
        "steps": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/step" } },
        "documentIds": { "$ref": "#/$defs/idReferences" }, "reservationIds": { "$ref": "#/$defs/idReferences" },
        "illustrationIds": { "$ref": "#/$defs/illustrationReferences" }
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "description", "targetType", "targetId"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "kind": { "enum": ["standard", "low-walking", "rain"] }, "label": { "$ref": "#/$defs/title" },
        "description": { "$ref": "#/$defs/description" }, "targetType": { "enum": ["day", "step"] }, "targetId": { "$ref": "#/$defs/stableId" }
      }
    },
    "document": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "resourceId"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "label": { "$ref": "#/$defs/title" }, "description": { "$ref": "#/$defs/description" }, "resourceId": { "$ref": "#/$defs/stableId" } }
    },
    "reservation": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "label": { "$ref": "#/$defs/title" }, "reference": { "$ref": "#/$defs/shortText" },
        "date": { "$ref": "#/$defs/date" }, "time": { "$ref": "#/$defs/localTime" }, "status": { "$ref": "#/$defs/title" },
        "links": { "$ref": "#/$defs/links" }, "documentIds": { "$ref": "#/$defs/idReferences" }
      }
    },
    "checklistTargetTravel": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "travel" } } },
    "checklistTargetDay": { "type": "object", "additionalProperties": false, "required": ["type", "dayId"], "properties": { "type": { "const": "day" }, "dayId": { "$ref": "#/$defs/stableId" } } },
    "checklistTargetStep": { "type": "object", "additionalProperties": false, "required": ["type", "stepId"], "properties": { "type": { "const": "step" }, "stepId": { "$ref": "#/$defs/stableId" } } },
    "checklistTarget": { "oneOf": [{ "$ref": "#/$defs/checklistTargetTravel" }, { "$ref": "#/$defs/checklistTargetDay" }, { "$ref": "#/$defs/checklistTargetStep" }] },
    "checklistItem": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "label": { "$ref": "#/$defs/title" }, "description": { "$ref": "#/$defs/checklistDescription" } }
    },
    "checklist": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "target", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "title": { "$ref": "#/$defs/title" }, "description": { "$ref": "#/$defs/checklistDescription" },
        "target": { "$ref": "#/$defs/checklistTarget" },
        "items": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/checklistItem" } }
      }
    },
    "licensedProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "creator", "sourceUrl", "licenseCode", "licenseUrl", "modified"],
      "properties": {
        "type": { "const": "licensed" },
        "creator": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sourceUrl": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" },
        "licenseCode": { "enum": ["PUBLIC-DOMAIN", "CC0-1.0", "CC-BY-2.0", "CC-BY-2.5", "CC-BY-3.0", "CC-BY-4.0", "CC-BY-SA-2.0", "CC-BY-SA-2.5", "CC-BY-SA-3.0", "CC-BY-SA-4.0"] },
        "licenseUrl": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" },
        "modified": { "type": "boolean" }
      }
    },
    "userProvidedProvenance": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "const": "user-provided" }, "credit": { "type": "string", "minLength": 1, "maxLength": 300 } }
    },
    "aiGeneratedProvenance": {
      "type": "object", "additionalProperties": false, "required": ["type", "provider"],
      "properties": {
        "type": { "const": "ai-generated" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 200 },
        "generatedAt": { "$ref": "#/$defs/date" }
      }
    },
    "illustrationProvenance": { "oneOf": [{ "$ref": "#/$defs/licensedProvenance" }, { "$ref": "#/$defs/userProvidedProvenance" }, { "$ref": "#/$defs/aiGeneratedProvenance" }] },
    "illustration": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "resourceId", "alt", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "resourceId": { "$ref": "#/$defs/stableId" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "caption": { "type": "string", "minLength": 1, "maxLength": 500 },
        "provenance": { "$ref": "#/$defs/illustrationProvenance" }
      }
    }
  }
}
